# The service binds to 127.0.0.1 by default. No real device or cloud is configured.
# Export these variables in the shell before starting; .env is not auto-loaded.
GEOHAZARD_DATA_DIR=./platform_backend/data
GEOHAZARD_DEMO=1
# Set an independent secret to require Bearer authentication for every API.
# GEOHAZARD_API_TOKEN=replace-with-your-local-secret
