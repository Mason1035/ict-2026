# Public application settings copied from the tested sdkconfig.local.
# Combine with sdkconfig.defaults; this is not the complete frozen SDK config.
# A new build has a new identity and needs separate verification.
# CONFIG_ESP_CONSOLE_SECONDARY_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=100
# CONFIG_NODE01_NETWORK_ENABLE is not set
CONFIG_NODE01_I2C_HZ=100000
CONFIG_NODE01_SD_KHZ=10000
CONFIG_NODE01_DIAG_ACQUISITION=y
# CONFIG_NODE01_DIAG_SENSORS_ONLY is not set
# CONFIG_NODE01_DIAG_STORAGE_ONLY is not set
# CONFIG_NODE01_STARTUP_CONCURRENT is not set
# CONFIG_NODE01_STARTUP_PROBE is not set
CONFIG_NODE01_STARTUP_IMU_FIRST=y
CONFIG_NODE01_IMU_DRDY=y
CONFIG_NODE01_CAPTURE_SECONDS=120
CONFIG_NODE01_SANDBOX_EXPERIMENT=y
CONFIG_NODE01_I2C_LOCK_DIAG_TRACE=y
