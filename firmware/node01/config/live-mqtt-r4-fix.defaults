# Reproducible live Wi-Fi/MQTT + SD-optional live decoupling build (based on verified 0.2.1-live-mqtt-r4-fix).
# Combine with sdkconfig.defaults in an isolated build directory (fits existing 0x100000 factory partition).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=100
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_LWIP_DHCPS is not set
# CONFIG_LWIP_IPV6 is not set
# CONFIG_LWIP_NETIF_LOOPBACK is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MQTT_TRANSPORT_SSL is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
CONFIG_NODE01_NETWORK_ENABLE=y
CONFIG_NODE01_I2C_HZ=100000
CONFIG_NODE01_SD_KHZ=1000
CONFIG_NODE01_DIAG_ACQUISITION=y
CONFIG_NODE01_STARTUP_IMU_FIRST=y
CONFIG_NODE01_IMU_DRDY=y
CONFIG_NODE01_CAPTURE_SECONDS=0
CONFIG_NODE01_SD_OPTIONAL_FOR_LIVE=y
