# Application settings matching the verified SD_R4_1122 firmware currently on NODE-01.
# Combine with sdkconfig.defaults in an isolated build directory when reproducing the
# TOE_BENCH_QUEUE_SD + WRSTRESS + 120s diagnostic capture build.
# CONFIG_ESP_CONSOLE_SECONDARY_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=100
# CONFIG_NODE01_NETWORK_ENABLE is not set
CONFIG_NODE01_MQTT_ONLY=y
CONFIG_NODE01_REAL_TEST_ONLY=y
CONFIG_NODE01_I2C_HZ=100000
CONFIG_NODE01_SD_KHZ=1000
# CONFIG_NODE01_DIAG_ACQUISITION is not set
# CONFIG_NODE01_DIAG_SENSORS_ONLY is not set
CONFIG_NODE01_DIAG_TOE_BENCH=y
# CONFIG_NODE01_DIAG_STORAGE_ONLY is not set
CONFIG_NODE01_TOE_BENCH_ADS=y
CONFIG_NODE01_TOE_BENCH_SD=y
CONFIG_NODE01_TOE_BENCH_QUEUE_SD=y
CONFIG_NODE01_IMU_DRDY=y
CONFIG_NODE01_CAPTURE_SECONDS=120
